# Postinst для luci-app-csqtt: чиним права и перезапускаем rpcd.

chmod +x /usr/bin/csqtt-connect    2>/dev/null || true
chmod +x /usr/bin/csqtt-disconnect 2>/dev/null || true
chmod +x /usr/bin/csqtt-logs       2>/dev/null || true
chmod +x /usr/bin/csqtt-status     2>/dev/null || true
chmod +x /usr/libexec/rpcd/luci.csqtt 2>/dev/null || true

mkdir -p /etc/csqtt
chmod 755 /etc/csqtt

mkdir -p /var/run/csqtt
chmod 755 /var/run/csqtt

[ -f /etc/csqtt/csqtt.log ] || : > /etc/csqtt/csqtt.log

/etc/init.d/rpcd restart 2>/dev/null || true
/etc/init.d/uhttpd restart 2>/dev/null || true

exit 0
