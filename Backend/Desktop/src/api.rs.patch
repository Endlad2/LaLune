+// GET /vk/token/raw — возвращает сам токен (не только его наличие).
+// Используется UI для передачи токена роутеру через POST /vk/token/submit.
+async fn vk_raw(State(state): State<Arc<AppState>>) -> impl IntoResponse {
+    let token = vk::read_token(&state.app_dir).unwrap_or_default();
+    Json(json!({ "token": token }))
+}
