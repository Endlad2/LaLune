<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LaLuneTokenFetcher.Linux</RootNamespace>
    <AssemblyName>LaLuneTokenFetcher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libs\LaLuneTokenFetcher.Core\LaLuneTokenFetcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Нативный C-хелпер копируется в выходную папку. -->
    <None Include="native\la-lune-webview-helper" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native\la-lune-webview-helper.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
